# Public (sent to the browser). Supabase project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: browser error reporting (production builds only).
NEXT_PUBLIC_SENTRY_DSN=
# The site's public address (default https://bbwtechinnovation.com).
NEXT_PUBLIC_SITE_URL=
# Server only (never NEXT_PUBLIC_): BBWFlow website intake for "Start a project" enquiries.
# Base URL of BBWFlow (locally http://localhost:8787) and its website intake key.
BBWFLOW_API_URL=
BBWFLOW_INTAKE_KEY=
